---
---

<section id="demonstracao" class="py-16 md:py-24 bg-[#FAFAFA] border-b border-[rgba(15,23,42,0.08)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl">
      <p class="font-mono text-xs font-semibold uppercase tracking-wider text-blue-700">Demonstração Interativa</p>
      <h2 class="mt-2 text-2xl sm:text-4xl font-bold tracking-tight text-[#0A0F1D]">
        Como o fluxo funciona na prática para os dois lados.
      </h2>
      <p class="mt-4 text-slate-600 text-base leading-relaxed">
        Eliminamos todos os atritos do processo: o cliente não precisa criar senha, e o contador nunca mais precisa conferir arquivo por arquivo em conversas de WhatsApp.
      </p>
    </div>

    <!-- Interactive Navigation Tabs -->
    <div class="mt-10 flex flex-wrap gap-2 border-b border-slate-200 pb-3" role="tablist" aria-label="Etapas da demonstração">
      <button 
        type="button" 
        role="tab" 
        aria-selected="true" 
        aria-controls="panel-contador" 
        id="tab-contador"
        class="demo-tab inline-flex items-center gap-2 rounded-md border px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 shadow-xs cursor-pointer"
      >
        <span class="tab-indicator size-2 rounded-full transition-colors"></span>
        1. Painel do Contador (Quem faltou)
      </button>

      <button 
        type="button" 
        role="tab" 
        aria-selected="false" 
        aria-controls="panel-cliente" 
        id="tab-cliente"
        class="demo-tab inline-flex items-center gap-2 rounded-md border px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 shadow-xs cursor-pointer"
      >
        <span class="tab-indicator size-2 rounded-full transition-colors"></span>
        2. Link de Upload sem Senha (Cliente)
      </button>

      <button 
        type="button" 
        role="tab" 
        aria-selected="false" 
        aria-controls="panel-zip" 
        id="tab-zip"
        class="demo-tab inline-flex items-center gap-2 rounded-md border px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 shadow-xs cursor-pointer"
      >
        <span class="tab-indicator size-2 rounded-full transition-colors"></span>
        3. Entrega em Zip Organizado
      </button>
    </div>

    <!-- Panels Container -->
    <div class="mt-6">

      <!-- PANEL 1: Contador -->
      <div id="panel-contador" role="tabpanel" aria-labelledby="tab-contador" class="demo-panel block">
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
          <!-- Toolbar -->
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 bg-slate-50/75 px-6 py-4">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-semibold text-slate-500 uppercase">Competência 08/2026</span>
              <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">
                42 Empresas cadastradas
              </span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-xs text-slate-500 font-mono">Filtro:</span>
              <span class="inline-flex rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-800">
                Apenas pendentes (4)
              </span>
            </div>
          </div>

          <!-- Table View -->
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
              <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase font-mono text-slate-500">
                <tr>
                  <th scope="col" class="py-3.5 px-6">Empresa / CNPJ</th>
                  <th scope="col" class="py-3.5 px-6">Responsável</th>
                  <th scope="col" class="py-3.5 px-6">Itens Concluídos</th>
                  <th scope="col" class="py-3.5 px-6">Status da Coleta</th>
                  <th scope="col" class="py-3.5 px-6 text-right">Ação</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-4 px-6 font-medium text-slate-900">
                    <div>Alfa Logística e Transportes</div>
                    <span class="font-mono text-xs text-slate-400">12.345.678/0001-90</span>
                  </td>
                  <td class="py-4 px-6">
                    <div>Carlos Eduardo</div>
                    <span class="text-xs text-slate-400 font-mono">+55 (11) 98765-4321</span>
                  </td>
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-2">
                      <span class="font-mono font-medium text-slate-900">4 / 4</span>
                      <span class="inline-block size-2 rounded-full bg-emerald-500"></span>
                    </div>
                  </td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center rounded bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 border border-emerald-200">
                      Concluído · Revisado
                    </span>
                  </td>
                  <td class="py-4 px-6 text-right">
                    <button class="text-xs font-semibold text-blue-600 hover:text-blue-800 transition">
                      Baixar Zip
                    </button>
                  </td>
                </tr>

                <tr class="hover:bg-slate-50/80 transition-colors bg-amber-50/20">
                  <td class="py-4 px-6 font-medium text-slate-900">
                    <div>Delta Tech Soluções</div>
                    <span class="font-mono text-xs text-slate-400">98.765.432/0001-10</span>
                  </td>
                  <td class="py-4 px-6">
                    <div>Mariana Ramos</div>
                    <span class="text-xs text-slate-400 font-mono">+55 (21) 99876-1122</span>
                  </td>
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-2">
                      <span class="font-mono font-medium text-amber-700">2 / 3</span>
                      <span class="inline-block size-2 rounded-full bg-amber-500"></span>
                    </div>
                  </td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center rounded bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 border border-amber-200">
                      Pendente: Extrato OFX
                    </span>
                  </td>
                  <td class="py-4 px-6 text-right">
                    <button class="text-xs font-semibold text-slate-700 hover:text-blue-600 transition">
                      Reenviar link
                    </button>
                  </td>
                </tr>

                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-4 px-6 font-medium text-slate-900">
                    <div>Supermercado Bela Vista</div>
                    <span class="font-mono text-xs text-slate-400">45.678.910/0001-22</span>
                  </td>
                  <td class="py-4 px-6">
                    <div>Roberto Santos</div>
                    <span class="text-xs text-slate-400 font-mono">+55 (31) 97654-9988</span>
                  </td>
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-2">
                      <span class="font-mono font-medium text-slate-900">5 / 5</span>
                      <span class="inline-block size-2 rounded-full bg-emerald-500"></span>
                    </div>
                  </td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center rounded bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 border border-emerald-200">
                      Concluído · Revisado
                    </span>
                  </td>
                  <td class="py-4 px-6 text-right">
                    <button class="text-xs font-semibold text-blue-600 hover:text-blue-800 transition">
                      Baixar Zip
                    </button>
                  </td>
                </tr>

              </tbody>
            </table>
          </div>
          
          <div class="border-t border-slate-200 bg-slate-50 px-6 py-3 flex items-center justify-between text-xs text-slate-500">
            <span>Mostrando 3 de 42 empresas</span>
            <span class="font-mono">Faltam apenas 4 empresas para fechar 100% da competência</span>
          </div>
        </div>
      </div>

      <!-- PANEL 2: Cliente Upload -->
      <div id="panel-cliente" role="tabpanel" aria-labelledby="tab-cliente" class="demo-panel hidden">
        <div class="max-w-2xl mx-auto rounded-xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          
          <!-- Header do Link Público -->
          <div class="border-b border-slate-100 pb-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold uppercase text-blue-700">Link sem senha · Acesso Exclusivo</span>
              <span class="inline-flex items-center gap-1 rounded bg-slate-100 px-2 py-0.5 font-mono text-[11px] text-slate-600">
                🔒 Válido até 10/09
              </span>
            </div>
            <h3 class="mt-2 text-xl font-bold text-slate-900">Envio de Documentos — Agosto/2026</h3>
            <p class="text-xs text-slate-500 mt-1">Empresa: <strong>Delta Tech Soluções</strong> · Solicitado por: <strong>Escritório Contábil Modelo</strong></p>
          </div>

          <!-- Document Checklist Items -->
          <div class="mt-6 space-y-4">
            
            <!-- Item 1: Concluído -->
            <div class="rounded-lg border border-emerald-200 bg-emerald-50/30 p-4 flex items-center justify-between">
              <div class="flex items-start gap-3">
                <span class="size-5 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs mt-0.5">✓</span>
                <div>
                  <p class="text-sm font-semibold text-slate-900">Folha de Ponto / Holerites</p>
                  <p class="text-xs text-slate-500">holerites-agosto-2026.pdf (1.2 MB)</p>
                </div>
              </div>
              <span class="text-xs font-medium text-emerald-700 font-mono">Entregue</span>
            </div>

            <!-- Item 2: Concluído -->
            <div class="rounded-lg border border-emerald-200 bg-emerald-50/30 p-4 flex items-center justify-between">
              <div class="flex items-start gap-3">
                <span class="size-5 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs mt-0.5">✓</span>
                <div>
                  <p class="text-sm font-semibold text-slate-900">Comprovantes de Pagamento de Tributos (DAS/FGTS)</p>
                  <p class="text-xs text-slate-500">comprovantes-tributos.pdf (450 KB)</p>
                </div>
              </div>
              <span class="text-xs font-medium text-emerald-700 font-mono">Entregue</span>
            </div>

            <!-- Item 3: Pendente (Área de Upload) -->
            <div class="rounded-lg border-2 border-dashed border-blue-400 bg-blue-50/20 p-6 text-center">
              <div class="mx-auto size-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 mb-2">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
                </svg>
              </div>
              <p class="text-sm font-semibold text-slate-900">Extrato Bancário Mensal (OFX ou PDF)</p>
              <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
                Arraste o arquivo aqui ou clique para selecionar do celular/computador.
              </p>
              <button type="button" class="mt-3 inline-flex items-center rounded-md bg-blue-700 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-800 transition">
                Selecionar Extrato
              </button>
            </div>

          </div>

          <div class="mt-6 border-t border-slate-100 pt-4 flex items-center justify-between text-xs text-slate-500">
            <span>O contador receberá a notificação automaticamente após o envio.</span>
            <span class="font-mono">Competa Safe Upload</span>
          </div>

        </div>
      </div>

      <!-- PANEL 3: Zip Delivery -->
      <div id="panel-zip" role="tabpanel" aria-labelledby="tab-zip" class="demo-panel hidden">
        <div class="max-w-2xl mx-auto rounded-xl border border-slate-800 bg-slate-900 p-6 sm:p-8 text-white shadow-xl">
          <div class="flex items-center justify-between border-b border-slate-700/60 pb-4">
            <div>
              <p class="text-xs font-mono text-blue-300 uppercase">PACOTE CONSOLIDADO DA COMPETÊNCIA</p>
              <h3 class="text-lg font-bold text-white mt-0.5">competencia-2026-08.zip</h3>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-950 px-3 py-1 font-mono text-xs text-emerald-300 border border-emerald-800">
              <span class="size-1.5 rounded-full bg-emerald-400"></span>
              Pronto para importação
            </span>
          </div>

          <!-- Tree View: Pastas com o nome registrado da empresa, sem hashes -->
          <div class="mt-6 font-mono text-xs text-slate-300 bg-slate-950/80 p-5 rounded-lg border border-slate-800 space-y-2 leading-relaxed overflow-x-auto">
            <div class="text-blue-300 font-semibold flex items-center gap-1.5">
              <span>📦</span>
              <span>competencia-2026-08.zip</span>
            </div>
            
            <div class="pl-4 text-slate-200 font-medium">📁 Alfa Logística e Transportes/</div>
            <div class="pl-8 text-slate-400">📁 Extrato Bancário Mensal/</div>
            <div class="pl-12 text-emerald-400">📄 extrato-agosto-2026.ofx</div>
            <div class="pl-8 text-slate-400">📁 Folha de Ponto/</div>
            <div class="pl-12 text-emerald-400">📄 folha-agosto.pdf</div>
            <div class="pl-8 text-slate-400">📁 Comprovantes de Tributos/</div>
            <div class="pl-12 text-emerald-400">📄 tributos-das-fgts.pdf</div>

            <div class="pl-4 text-slate-200 font-medium pt-1">📁 Delta Tech Soluções/</div>
            <div class="pl-8 text-slate-400">📁 Folha de Ponto/</div>
            <div class="pl-12 text-emerald-400">📄 ponto-mensal.pdf</div>
            <div class="pl-8 text-slate-400">📁 Comprovantes de Tributos/</div>
            <div class="pl-12 text-emerald-400">📄 guia-fgts-quitada.pdf</div>

            <div class="pl-4 text-slate-200 font-medium pt-1">📁 Supermercado Bela Vista/</div>
            <div class="pl-8 text-slate-400">📁 Extrato Bancário Mensal/</div>
            <div class="pl-12 text-emerald-400">📄 extrato-bradesco.ofx</div>
            <div class="pl-8 text-slate-400">📁 Documentos Fiscais/</div>
            <div class="pl-12 text-emerald-400">📄 notas-fiscais-entrada.zip</div>
          </div>

          <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
            <span class="text-xs text-slate-400">Pastas nomeadas exatamente com o nome cadastrado de cada empresa, sem hashes ou códigos confusos.</span>
            <a 
              href="https://app.competa.com.br"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-md bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-blue-500 transition"
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              <span>Experimentar com suas empresas</span>
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .demo-tab {
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .demo-tab[aria-selected="true"] {
    background-color: #1D4ED8 !important;
    color: #ffffff !important;
    border-color: #1D4ED8 !important;
  }
  .demo-tab[aria-selected="true"]:hover {
    background-color: #1E40AF !important;
    color: #ffffff !important;
    border-color: #1E40AF !important;
  }
  .demo-tab[aria-selected="true"] .tab-indicator {
    background-color: #93c5fd !important;
  }

  .demo-tab[aria-selected="false"] {
    background-color: #ffffff !important;
    color: #334155 !important;
    border-color: #cbd5e1 !important;
  }
  .demo-tab[aria-selected="false"]:hover {
    background-color: #f8fafc !important;
    color: #0f172a !important;
    border-color: #94a3b8 !important;
  }
  .demo-tab[aria-selected="false"] .tab-indicator {
    background-color: #94a3b8 !important;
  }
</style>

<script>
  function setupDemoTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.demo-tab');
    const panels = document.querySelectorAll<HTMLElement>('.demo-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.setAttribute('aria-selected', 'false'));
        panels.forEach(p => p.classList.add('hidden'));

        tab.setAttribute('aria-selected', 'true');

        const targetPanelId = tab.getAttribute('aria-controls');
        if (targetPanelId) {
          const panel = document.getElementById(targetPanelId);
          if (panel) {
            panel.classList.remove('hidden');
          }
        }
      });
    });
  }

  // Initialize on page load
  setupDemoTabs();
</script>
