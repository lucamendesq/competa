---
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-50 w-full border-b border-[rgba(15,23,42,0.08)] bg-[rgba(250,250,250,0.85)] backdrop-blur-md transition-all">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-8">
      <Logo variant="horizontal" theme="dark" />
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600" aria-label="Navegação principal">
        <a href="#demonstracao" class="transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded px-1 py-0.5">
          Demonstração
        </a>
        <a href="#como-funciona" class="transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded px-1 py-0.5">
          Como funciona
        </a>
        <a href="#diferenciais" class="transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded px-1 py-0.5">
          O Contraste
        </a>
        <a href="#precos" class="transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded px-1 py-0.5">
          Preços públicos
        </a>
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a 
        href="https://app.competa.com.br" 
        class="hidden sm:inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3.5 py-1.5 text-sm font-medium text-slate-800 shadow-xs transition hover:border-slate-400 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
      >
        Acessar painel
      </a>
      <a 
        href="https://app.competa.com.br" 
        class="inline-flex items-center justify-center rounded-md bg-[#1D4ED8] px-4 py-1.5 text-sm font-medium text-white shadow-xs transition hover:bg-[#1E40AF] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
      >
        Começar 14 dias grátis
      </a>
    </div>
  </div>
</header>
