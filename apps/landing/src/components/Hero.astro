---
---

<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 border-b border-[rgba(15,23,42,0.08)] bg-white">
  <!-- Subtle architectural hairline grid -->
  <div class="editorial-grid absolute inset-0 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Technical Category Pill -->
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3 py-1 text-xs font-semibold tracking-wide text-blue-900 mb-6">
          <span class="inline-block size-1.5 rounded-full bg-blue-600 animate-pulse"></span>
          COLETA CONTÁBIL AUTOMATIZADA
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#0A0F1D] leading-[1.12]">
          Pare de garimpar documento contábil no WhatsApp.
        </h1>

        <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-2xl font-normal leading-relaxed">
          Defina o checklist mensal de cada empresa, <strong class="font-semibold text-slate-900">abra a competência em 1 clique</strong> e receba os arquivos por um <strong class="font-semibold text-slate-900">link sem senha</strong>. Veja quem faltou no painel e baixe tudo pronto em um único arquivo zip por empresa.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
          <a
            href="https://app.competa.com.br"
            class="inline-flex items-center justify-center gap-2 rounded-md bg-[#1D4ED8] px-6 py-3.5 text-base font-semibold text-white shadow-xs transition hover:bg-[#1E40AF] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 active:scale-[0.99]"
          >
            <span>Iniciar teste grátis de 14 dias</span>
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>

          <a
            href="#demonstracao"
            class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-5 py-3.5 text-base font-medium text-slate-700 transition hover:border-slate-400 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          >
            Ver demonstração interativa
          </a>
        </div>

        <!-- Reassurance Footnotes -->
        <div class="mt-8 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-slate-500 font-medium">
          <div class="flex items-center gap-1.5">
            <svg class="size-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>Sem cartão de crédito</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="size-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>Link sem cadastro para o cliente</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="size-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>Preço público a partir de R$ 79/mês</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Tactile "Live Competence Card" Asymmetric Visual (5 cols) -->
      <div class="lg:col-span-5 relative">
        <div class="rounded-xl border border-slate-200/80 bg-slate-900 p-1 shadow-2xl shadow-slate-900/10">
          <!-- Terminal/Ledger Header -->
          <div class="flex items-center justify-between border-b border-slate-800 px-4 py-2.5 bg-slate-950/80 rounded-t-lg">
            <div class="flex items-center gap-2">
              <span class="size-2.5 rounded-full bg-slate-700"></span>
              <span class="size-2.5 rounded-full bg-slate-700"></span>
              <span class="size-2.5 rounded-full bg-slate-700"></span>
              <span class="ml-2 font-mono text-xs text-slate-400 font-medium">PAINEL CONTÁBIL · COMPETA</span>
            </div>
            <span class="inline-flex items-center rounded-sm bg-emerald-950/80 px-2 py-0.5 font-mono text-[10px] font-semibold text-emerald-400 border border-emerald-800/60">
              ● ABERTA
            </span>
          </div>

          <!-- Card Body: Concrete Accounting Reality -->
          <div class="p-5 text-white bg-slate-900 space-y-4 rounded-b-lg">
            
            <div class="flex items-baseline justify-between border-b border-slate-800 pb-3">
              <div>
                <p class="font-mono text-xs text-slate-400">COMPETÊNCIA ATUAL</p>
                <p class="text-xl font-bold tracking-tight text-white mt-0.5">Agosto / 2026</p>
              </div>
              <div class="text-right">
                <span class="font-mono text-xs text-slate-400">STATUS DA COBRANÇA</span>
                <p class="font-mono text-sm font-semibold text-emerald-400 mt-0.5">38 / 42 Entregues (90%)</p>
              </div>
            </div>

            <!-- Mini Item Matrix -->
            <div class="space-y-2 text-xs">
              <div class="flex items-center justify-between p-2.5 rounded bg-slate-800/60 border border-slate-700/50">
                <div class="flex items-center gap-2.5">
                  <span class="size-2 rounded-full bg-emerald-400"></span>
                  <div>
                    <span class="font-medium text-slate-200">ACME Indústria e Comércio</span>
                    <span class="block text-[10px] font-mono text-slate-400">4 de 4 itens revisados</span>
                  </div>
                </div>
                <span class="font-mono text-[11px] text-emerald-400 bg-emerald-950/40 px-2 py-0.5 rounded border border-emerald-900/60">
                  Pronto p/ Zip
                </span>
              </div>

              <div class="flex items-center justify-between p-2.5 rounded bg-slate-800/60 border border-slate-700/50">
                <div class="flex items-center gap-2.5">
                  <span class="size-2 rounded-full bg-amber-400 animate-pulse"></span>
                  <div>
                    <span class="font-medium text-slate-200">Vanguarda Tech Ltda</span>
                    <span class="block text-[10px] font-mono text-slate-400">Falta Extrato Bancário OFX</span>
                  </div>
                </div>
                <span class="font-mono text-[11px] text-amber-400 bg-amber-950/40 px-2 py-0.5 rounded border border-amber-900/60">
                  Link ativo (WhatsApp)
                </span>
              </div>

              <div class="flex items-center justify-between p-2.5 rounded bg-slate-800/60 border border-slate-700/50">
                <div class="flex items-center gap-2.5">
                  <span class="size-2 rounded-full bg-emerald-400"></span>
                  <div>
                    <span class="font-medium text-slate-200">Solaris Energia Renovável</span>
                    <span class="block text-[10px] font-mono text-slate-400">3 de 3 itens revisados</span>
                  </div>
                </div>
                <span class="font-mono text-[11px] text-emerald-400 bg-emerald-950/40 px-2 py-0.5 rounded border border-emerald-900/60">
                  Pronto p/ Zip
                </span>
              </div>
            </div>

            <!-- Action simulation footer -->
            <div class="pt-2 flex items-center justify-between text-xs border-t border-slate-800">
              <span class="text-slate-400 font-mono text-[11px]">Download em lote:</span>
              <span class="inline-flex items-center gap-1.5 font-semibold text-blue-300 hover:text-blue-200 transition cursor-default">
                <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                Baixar pacote 08-2026.zip
              </span>
            </div>

          </div>
        </div>

        <!-- Floating Asymmetric Annotation Tag -->
        <div class="absolute -bottom-4 -left-4 sm:-bottom-5 sm:-left-6 rounded-md bg-white p-3 border border-slate-200 shadow-lg text-slate-800 text-xs font-medium flex items-center gap-2.5">
          <div class="size-2 rounded-full bg-blue-600"></div>
          <span><strong>1 clique</strong> congela prazos e envia o link direto ao cliente</span>
        </div>
      </div>

    </div>
  </div>
</section>
