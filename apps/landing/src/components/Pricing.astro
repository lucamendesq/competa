---
import { PAID_PLANS, PLANS, type PaidPlanName } from '@competa/contracts';

const brl = (value: number) =>
  new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value);

const ANCHOR: PaidPlanName = 'profissional';

const TAGLINE: Record<PaidPlanName, { kicker: string; blurb: string }> = {
  essencial: {
    kicker: 'INICIAL',
    blurb: 'Para contadores autônomos e carteiras enxutas.',
  },
  profissional: {
    kicker: 'ESCRITÓRIOS EM CRESCIMENTO',
    blurb: 'A carteira média do escritório brasileiro inteira dentro do ciclo da competência.',
  },
  escritorio: {
    kicker: 'ESCALA',
    blurb: 'Para quem passou dos 80 clientes e não quer pagar por usuário.',
  },
};

/** As 8 linhas da D18. Disponibilidade nunca é só cor: toda célula carrega texto. */
const COMPARISON: { label: string; values: Record<PaidPlanName, string> }[] = [
  {
    label: 'Preço por mês',
    values: {
      essencial: brl(PLANS.essencial.priceMonthly),
      profissional: brl(PLANS.profissional.priceMonthly),
      escritorio: brl(PLANS.escritorio.priceMonthly),
    },
  },
  {
    label: 'Empresas ativas',
    values: {
      essencial: `até ${PLANS.essencial.companyCap}`,
      profissional: `até ${PLANS.profissional.companyCap}`,
      escritorio: `até ${PLANS.escritorio.companyCap}`,
    },
  },
  {
    label: 'Contadores da equipe',
    values: {
      essencial: '✓ Ilimitados',
      profissional: '✓ Ilimitados',
      escritorio: '✓ Ilimitados',
    },
  },
  {
    label: 'WhatsApp oficial no seu número',
    values: { essencial: '✓ Sim', profissional: '✓ Sim', escritorio: '✓ Sim' },
  },
  {
    label: 'Lembretes automáticos',
    values: {
      essencial: '✓ Cadência padrão',
      profissional: '✓ Cadência configurável',
      escritorio: '✓ Cadência configurável',
    },
  },
  {
    label: 'Sua marca no link e nos e-mails',
    values: { essencial: '— Não', profissional: '✓ Sim', escritorio: '✓ Sim' },
  },
  {
    label: 'Download em zip',
    values: {
      essencial: '✓ Por empresa',
      profissional: '✓ Por empresa e da competência inteira',
      escritorio: '✓ Por empresa e da competência inteira',
    },
  },
  {
    label: 'Histórico dos documentos',
    values: { essencial: '✓ 5 anos', profissional: '✓ 5 anos', escritorio: '✓ 5 anos' },
  },
];

const perCompany = (name: PaidPlanName) =>
  brl(PLANS[name].priceMonthly / PLANS[name].companyCap);
---

<section id="precos" class="py-16 md:py-24 bg-[#FAFAFA] border-b border-[rgba(15,23,42,0.08)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <p class="font-mono text-xs font-semibold uppercase tracking-wider text-blue-700">Preços Transparentes</p>
      <h2 class="mt-2 text-2xl sm:text-4xl font-bold tracking-tight text-[#0A0F1D]">
        Planos claros. Sem surpresas ou taxas de implantação.
      </h2>
      <p class="mt-4 text-slate-700 text-base leading-relaxed">
        Diferente das suítes tradicionais com preços ocultos e vendedores insistentes, no Competa o valor é
        público e você paga pelas <strong>empresas ativas cadastradas</strong> — nunca por usuário.
        Contadores ilimitados em todos os planos.
      </p>
    </div>

    <!-- Alternador mensal/anual -->
    <div class="mt-8 flex justify-center">
      <div
        id="ciclo"
        class="inline-flex rounded-lg border border-slate-300 bg-white p-1"
        role="group"
        aria-label="Ciclo de cobrança"
      >
        <button
          type="button"
          data-ciclo="mensal"
          aria-pressed="true"
          class="ciclo-btn rounded-md px-4 py-2 text-xs font-semibold text-white bg-[#1D4ED8] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
        >
          Mensal
        </button>
        <button
          type="button"
          data-ciclo="anual"
          aria-pressed="false"
          class="ciclo-btn rounded-md px-4 py-2 text-xs font-semibold text-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
        >
          Anual · 2 meses grátis
        </button>
      </div>
    </div>

    <!-- Cards -->
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch max-w-6xl mx-auto">
      {
        PAID_PLANS.map((plan) => {
          const name = plan.name as PaidPlanName;
          const anchor = name === ANCHOR;

          return (
            <div
              class={`rounded-lg bg-white p-6 sm:p-8 flex flex-col justify-between relative ${
                anchor ? 'border-2 border-blue-700 shadow-lg' : 'border border-slate-200 shadow-xs'
              }`}
            >
              {anchor && (
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-blue-700 px-3 py-0.5 text-[10px] font-mono font-bold uppercase tracking-wider text-white shadow-xs">
                  MAIS ESCOLHIDO
                </div>
              )}

              <div>
                <span class={`font-mono text-xs font-semibold uppercase ${anchor ? 'text-blue-700' : 'text-slate-600'}`}>
                  {TAGLINE[name].kicker}
                </span>
                <h3 class="mt-1 text-xl font-bold text-slate-900">{plan.label}</h3>
                <p class="mt-2 text-xs text-slate-700">{TAGLINE[name].blurb}</p>

                <div class="mt-6">
                  <p class="preco-mensal flex items-baseline gap-1">
                    <span class="text-3xl font-extrabold text-slate-900">{brl(plan.priceMonthly)}</span>
                    <span class="text-xs text-slate-600 font-mono">/mês</span>
                  </p>
                  <p class="preco-anual hidden">
                    <span class="flex items-baseline gap-1">
                      <span class="text-3xl font-extrabold text-slate-900">{brl(plan.priceYearly)}</span>
                      <span class="text-xs text-slate-600 font-mono">/ano</span>
                    </span>
                    <span class="mt-1 block text-xs text-slate-700">
                      Equivale a {brl(plan.priceYearly / 12)}/mês — economia de{' '}
                      <strong>{brl(plan.priceMonthly * 12 - plan.priceYearly)}</strong> no ano.
                    </span>
                  </p>
                  <p class="mt-2 text-xs text-slate-700">
                    {perCompany(name)} por empresa/mês no teto do plano.
                  </p>
                </div>

                <ul class="mt-6 space-y-3 text-xs text-slate-700">
                  {plan.highlights.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-700 font-bold" aria-hidden="true">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 pt-4 border-t border-slate-100">
                <a
                  href="https://app.competa.com.br"
                  class={
                    anchor
                      ? 'w-full inline-flex items-center justify-center rounded-md bg-[#1D4ED8] py-2.5 text-xs font-semibold text-white hover:bg-[#1E40AF] transition shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2'
                      : 'w-full inline-flex items-center justify-center rounded-md border border-slate-300 bg-white py-2.5 text-xs font-semibold text-slate-800 hover:bg-slate-50 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600'
                  }
                >
                  Iniciar 14 dias grátis
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Comparativo -->
    <div class="mt-14 max-w-6xl mx-auto">
      <h3 class="text-lg font-bold text-slate-900">O que muda entre os planos</h3>
      <div class="mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full min-w-[640px] text-left text-xs">
          <caption class="sr-only">Comparativo dos planos Essencial, Profissional e Escritório</caption>
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50">
              <th scope="col" class="px-4 py-3 font-semibold text-slate-900">&nbsp;</th>
              {
                PAID_PLANS.map((plan) => (
                  <th
                    scope="col"
                    class={`px-4 py-3 font-semibold ${plan.name === ANCHOR ? 'text-blue-700' : 'text-slate-900'}`}
                  >
                    {plan.label}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              COMPARISON.map((row) => (
                <tr class="border-b border-slate-100 last:border-0">
                  <th scope="row" class="px-4 py-3 font-medium text-slate-900">{row.label}</th>
                  {
                    PAID_PLANS.map((plan) => (
                      <td class="px-4 py-3 text-slate-700">{row.values[plan.name as PaidPlanName]}</td>
                    ))
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-slate-600">
        O teste de 14 dias libera os recursos do Profissional, com até {PLANS.trial.companyCap} empresas.
      </p>
    </div>

    <!-- Os três argumentos -->
    <div class="mt-12 grid gap-6 md:grid-cols-3 max-w-6xl mx-auto">
      <div class="rounded-lg border border-slate-200 bg-white p-5">
        <h4 class="text-sm font-bold text-slate-900">Contadores ilimitados, de verdade</h4>
        <p class="mt-2 text-xs text-slate-700 leading-relaxed">
          Toda suíte cobra por usuário. Um escritório de 4 pessoas paga cerca de R$200/mês no Omie G-Click
          <strong> só em assentos</strong> — antes de usar qualquer recurso. Aqui, a 5ª pessoa da equipe custa
          R$0.
        </p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-5">
        <h4 class="text-sm font-bold text-slate-900">{perCompany(ANCHOR)} por cliente</h4>
        <p class="mt-2 text-xs text-slate-700 leading-relaxed">
          No Profissional, {brl(PLANS.profissional.priceMonthly)} dividido por
          {' '}{PLANS.profissional.companyCap} empresas dá <strong>{perCompany(ANCHOR)} por empresa/mês</strong>,
          contra um honorário de R$300 a R$500 que você cobra de cada uma.
        </p>
      </div>
      <div class="rounded-lg border border-amber-300 bg-amber-50 p-5">
        <h4 class="text-sm font-bold text-slate-900">O WhatsApp é cobrado pela Meta, não por nós</h4>
        <p class="mt-2 text-xs text-slate-800 leading-relaxed">
          A integração é no <strong>seu próprio número</strong>: você conecta sua conta oficial e a
          <strong> Meta cobra você direto</strong>, sem intermediário nem margem nossa. No uso típico de um
          escritório pequeno isso fica em <strong>R$10 a R$20/mês</strong>, e esse valor
          <strong> não está incluído</strong> no preço do Competa. As suítes embutem e remarcam; preferimos
          dizer antes da compra.
        </p>
      </div>
    </div>

    <div class="mt-10 text-center text-xs text-slate-600 font-mono">
      Todos os planos incluem teste gratuito de 14 dias sem necessidade de cartão de crédito. Cancele quando quiser.<br />
      O plano anual é cobrado de uma vez, em boleto com Pix no QR Code.
    </div>
  </div>
</section>

<script>
  const group = document.getElementById('ciclo');

  group?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.ciclo-btn');
    if (!button) return;

    const anual = button.dataset.ciclo === 'anual';

    group.querySelectorAll<HTMLButtonElement>('.ciclo-btn').forEach((item) => {
      const active = item === button;
      item.setAttribute('aria-pressed', String(active));
      item.classList.toggle('bg-[#1D4ED8]', active);
      item.classList.toggle('text-white', active);
      item.classList.toggle('text-slate-700', !active);
    });

    document.querySelectorAll('.preco-mensal').forEach((el) => el.classList.toggle('hidden', anual));
    document.querySelectorAll('.preco-anual').forEach((el) => el.classList.toggle('hidden', !anual));
  });
</script>
