NODE_ENV=development
PORT=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

WEB_URL=http://localhost:4200
INVITE_TTL_DAYS=7
UPLOAD_LINK_TTL_DAYS=30

# Provedores externos: obrigatórios com NODE_ENV=production, ignorados fora dela.
# Em development/test o R2 vira disco (STORAGE_LOCAL_DIR), a Resend vira log no console
# e o Web Push vira log no console — nenhuma credencial é necessária para rodar local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
STORAGE_LOCAL_DIR=.storage

RESEND_API_KEY=
# Um domínio SEU, verificado na Resend.
EMAIL_FROM=

# Web Push. Opcional até em produção: sem as chaves, o push cai no log.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
