{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:debug": "tsx watch --inspect src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/infra/database/seeds/index.ts",
    "create-firm": "tsx src/scripts/create-firm.ts",
    "dev": "tsx watch src/main.ts",
    "check:recovery-token": "tsx src/scripts/check-recovery-token.ts",
    "check:plan-cap": "tsx src/scripts/verify-plan-cap.ts",
    "check:plan-gates": "tsx src/scripts/verify-plan-gates.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@competa/contracts": "workspace:*",
    "@effect/platform-node": "^4.0.6",
    "@sentry/node": "^10.74.0",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.2",
    "cors": "2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "^4.0.6",
    "eventemitter2": "^6.4.9",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.25.0",
    "tldts": "^7.4.14",
    "tsx": "^4.23.12",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.6",
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/pino-http": "^6.1.0",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  }
